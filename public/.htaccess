# Deployed to public_html/.htaccess (Vite copies everything in public/ to dist/).

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite the API — those are real PHP files.
  RewriteRule ^api/ - [L]

  # Serve real files and directories as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls through to the SPA.
  RewriteRule ^ index.html [L]
</IfModule>

# Belt and braces: the data file is meant to live outside public_html, but if
# it ever ends up in here it must not be downloadable.
<FilesMatch "\.(json|lock|tmp)$">
  Require all denied
</FilesMatch>
<Files "board.json">
  Require all denied
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
  # This board is for the team, not for search engines.
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Vite fingerprints filenames, so hashed assets can cache hard.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # ...but the entry point must always be revalidated, or deploys go unseen.
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>
